APP_DOMAIN=zeit.meine-domain.de
ZEITBUCH_USER=hannah
# Den von Caddy erzeugten Hash zwischen die einfachen Anführungszeichen setzen (nur für Docker/Caddy).
ZEITBUCH_PASSWORD_HASH=''

# Anmeldung. Produktivwerte in Vercel setzen, lokale Werte in .env.local.
AUTH_URL=http://127.0.0.1:3000
AUTH_SECRET=
ZEITBUCH_USERNAME=
ZEITBUCH_PASSWORD_HASH=

# Turso in Produktion; lokal leer lassen für SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
